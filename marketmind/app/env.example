# MarketMind runtime — copy to app/.env and fill (WIRING.md walks it). NEVER commit .env (Art XI).
MM_MODE=live                      # sim | live
NAMED_RESELLER=unset              # must match kickoff/consent.txt (Art III)
NAMED_ROLE=reseller

APFY_TOKEN=
APIFY_ACTOR_LISTINGS=haketa/marktplaats-scraper   # Benelux classifieds scraper
APIFY_ACTOR_COMPS=automation-lab/ebay-scraper    # Multi-marketplace eBay comps scraper

EBAY_MARKETPLACE=DE                  # DE (Germany), FR, IT, ES = native EUR comps; US = USD
MP_TECH_QUERIES=nintendo switch,ps5,iphone 14,macbook  # targeted high-margin Dutch tech
MP_MAX_PER_QUERY=10                  # items to scrape per category query
CYCLE_INTERVAL_S=300                 # loop cycle interval in seconds
COMPS_CACHE_TTL_S=7200               # comps cache expiration (2 hours)

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

AIRTABLE_PAT=                     # optional at M0 (receipts degrade to out/receipts.jsonl, Art VII.1)
AIRTABLE_BASE=
AIRTABLE_TABLE=receipts

BROWSER_USE_KEY=                  # optional at M0 (draft-assist default)
MODEL_OBSERVE=Qwen/Qwen3-VL-8B-Instruct   # must differ from judge (Art II.3)
MODEL_JUDGE=Qwen/Qwen3-8B
TF_BASE_URL=                      # probe at T04; record live|fallback
TF_API_KEY=

MAX_COLD_OUTREACH=5
DEMO_TOKEN=                       # any demo endpoint; never prefilled
AUTO_PAUSE=0                      # 1 = kill switch engaged (observe-only)

